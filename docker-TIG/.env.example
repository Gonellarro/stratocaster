# --- CONFIGURACIÓN DE INFLUXDB (v2) ---
INFLUX_USER=admin
INFLUX_PASSWORD=TU_INFLUXDB_PASSWORD_AQUI
INFLUX_ORG=MartiHomelab
INFLUX_BUCKET=telegraf_db
# El Token es la llave maestra para que Telegraf y Grafana hablen con InfluxDB.
# Genera una cadena larga alfanumérica aleatoria para producción:
INFLUX_TOKEN=TU_INFLUXDB_TOKEN_MASTER_AQUI

# --- CONFIGURACIÓN DE GRAFANA ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=TU_GRAFANA_PASSWORD_AQUI
GF_SERVER_ROOT_URL=https://staging-stratocaster.martivich.es/grafana/

# --- VERSIONES DE LAS IMÁGENES ---
TELEGRAF_VERSION=1.37-alpine
INFLUX_VERSION=2.7.11
GRAFANA_VERSION=11.6.1
MOSQUITTO_VERSION=2.1.2-alpine

# --- CONFIGURACIÓN DE TELEGRAF (Para conectar a Mosquitto) ---
TELEGRAF_MQTT_USER=admin
TELEGRAF_MQTT_PASSWORD=TU_TELEGRAF_MQTT_PASSWORD_AQUI
