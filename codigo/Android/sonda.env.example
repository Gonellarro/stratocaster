# ==============================================================================
# CONFIGURACIÓN DE LA SONDA (Android) - PLANTILLA DE EJEMPLO
# Copia este archivo como 'sonda.env' en la misma carpeta y edita tus credenciales.
# ==============================================================================

# URL del servidor web para alojar fotos (ej: local o dominio público)
# IMAGE_SERVER_URL="http://192.168.1.196:5000"
IMAGE_SERVER_URL="https://stratocaster.martivich.es" 

# Credenciales del Broker MQTT
# MQTT_HOST="192.168.1.196"
MQTT_HOST="stratocaster.martivich.es"
MQTT_PORT=1883
MQTT_USER="admin"
MQTT_PASS="TU_CONTRASEÑA_MQTT_AQUÍ"

# Calidad mínima del GPS GNSS usada por sonda_loop.sh
GPS_MAX_ACCURACY_METERS=75
GPS_MAX_AGE_MS=120000
# Tiempo máximo del check GPS para adquirir un fix GNSS real.
GPS_FIX_TIMEOUT_SECONDS=45

# Identificador único de este dispositivo (ej: movil_sonda_1, movil_sonda_2, movil_dron, etc.)
DEVICE_ID="movil_sonda_1"

# Directorios públicos Android y único MP3 operativo: baliza de recuperación.
PHOTO_DIR="$HOME/storage/pictures/Sonda"
AUDIO_DIR="$HOME/storage/music/Sonda"
ALARM_AUDIO="$AUDIO_DIR/alarma.mp3"
