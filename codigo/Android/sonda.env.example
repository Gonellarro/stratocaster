# ==============================================================================
# CONFIGURACIÓN DE LA SONDA (Android) - PLANTILLA DE EJEMPLO
# Copia este archivo como 'sonda.env' en la misma carpeta y edita tus credenciales.
# ==============================================================================

# Credenciales del broker MQTT
MQTT_HOST="stratocaster.martivich.es"
MQTT_PORT=1883
MQTT_USER="admin"
MQTT_PASS="TU_CONTRASEÑA_MQTT_AQUÍ"

# Identificador único del móvil emisor.
DEVICE_ID="movil_sonda_1"

# Segundos entre envíos de telemetría.
TELEMETRY_INTERVAL=15
